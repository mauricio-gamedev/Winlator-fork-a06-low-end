diff --git a/app/src/main/java/com/winlator/core/A06Preinstall.java b/app/src/main/java/com/winlator/core/A06Preinstall.java
new file mode 100644
index 0000000..25f8efd
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/A06Preinstall.java
@@ -0,0 +1,87 @@
+package com.winlator.core;
+
+import android.content.Context;
+
+import com.winlator.container.Container;
+import com.winlator.xenvironment.RootFS;
+
+import java.io.File;
+import java.util.concurrent.Executors;
+
+/**
+ * Installs the small, offline A06 compatibility pack used by the default
+ * container profile. The normal Winlator setup remains responsible for
+ * registry overrides and user-selected component versions.
+ */
+public abstract class A06Preinstall {
+    public static final String VERSION = "1";
+    private static final String ROOTFS_MARKER = ".winlator/a06-preinstall";
+    private static final String CONTAINER_MARKER = ".a06-preinstall";
+
+    private static final String[] ROOTFS_ASSETS = {
+            "graphics_driver/vortek-"+DefaultVersion.VORTEK+".tzst",
+            "graphics_driver/gladio-"+DefaultVersion.GLADIO+".tzst"
+    };
+
+    private static final String[] CONTAINER_ASSETS = {
+            "dxwrapper/dxvk-"+DefaultVersion.MINOR_DXVK+".tzst",
+            "dxwrapper/d8vk-"+DefaultVersion.D8VK+".tzst",
+            "dxwrapper/vkd3d-"+DefaultVersion.VKD3D+".tzst"
+    };
+
+    public static void prepareRootFSAsync(Context context) {
+        Executors.newSingleThreadExecutor().execute(() -> prepareRootFS(context));
+    }
+
+    public static synchronized boolean prepareRootFS(Context context) {
+        RootFS rootFS = RootFS.find(context);
+        File marker = new File(rootFS.getRootDir(), ROOTFS_MARKER);
+        if (isPrepared(marker)) return true;
+
+        boolean success = true;
+        for (String asset : ROOTFS_ASSETS) {
+            success &= TarCompressorUtils.extract(TarCompressorUtils.Type.ZSTD, context, asset, rootFS.getRootDir());
+        }
+        GeneralComponents.extractFile(GeneralComponents.Type.BOX64, context, DefaultVersion.BOX64, DefaultVersion.BOX64);
+
+        if (success) writeMarker(marker);
+        return success;
+    }
+
+    public static synchronized boolean prepareContainer(Context context, Container container) {
+        File marker = new File(container.getRootDir(), CONTAINER_MARKER);
+        if (isPrepared(marker)) return true;
+
+        File windowsDir = new File(container.getRootDir(), ".wine/drive_c/windows");
+        windowsDir.mkdirs();
+
+        boolean success = true;
+        for (String asset : CONTAINER_ASSETS) {
+            success &= TarCompressorUtils.extract(TarCompressorUtils.Type.ZSTD, context, asset, windowsDir);
+        }
+
+        for (String[] component : new KeyValueSet(Container.DEFAULT_WINCOMPONENTS)) {
+            if (component.length == 2 && component[1].equals("1")) {
+                success &= TarCompressorUtils.extract(
+                        TarCompressorUtils.Type.ZSTD,
+                        context,
+                        "wincomponents/"+component[0]+".tzst",
+                        windowsDir
+                );
+            }
+        }
+
+        if (success) writeMarker(marker);
+        return success;
+    }
+
+    private static boolean isPrepared(File marker) {
+        return marker.isFile() && VERSION.equals(FileUtils.readString(marker));
+    }
+
+    private static void writeMarker(File marker) {
+        File parent = marker.getParentFile();
+        if (parent != null) parent.mkdirs();
+        FileUtils.writeString(marker, VERSION);
+    }
+}
