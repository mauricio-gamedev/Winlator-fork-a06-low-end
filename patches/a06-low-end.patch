diff --git a/app/src/main/java/com/winlator/core/A06CompatibilityPackManager.java b/app/src/main/java/com/winlator/core/A06CompatibilityPackManager.java
new file mode 100644
index 0000000..f4030fd
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/A06CompatibilityPackManager.java
@@ -0,0 +1,116 @@
+package com.winlator.core;
+
+import android.content.Context;
+
+import com.winlator.R;
+import com.winlator.box64.Box64Preset;
+import com.winlator.container.Container;
+import com.winlator.container.DXWrappers;
+
+import java.util.ArrayList;
+
+/**
+ * Applies small, offline compatibility profiles to an individual container.
+ * Packs only use components already shipped with the A06 build.
+ */
+public abstract class A06CompatibilityPackManager {
+    public static final String VERSION = "1";
+    public static final String PACK_VN_2D = "vn_2d";
+    public static final String PACK_LIGHT_3D = "light_3d";
+
+    public static final class Pack {
+        public final String id;
+        private final int nameResId;
+        private final int descriptionResId;
+
+        private Pack(String id, int nameResId, int descriptionResId) {
+            this.id = id;
+            this.nameResId = nameResId;
+            this.descriptionResId = descriptionResId;
+        }
+
+        public String getName(Context context) {
+            return context.getString(nameResId);
+        }
+
+        public String getDescription(Context context) {
+            return context.getString(descriptionResId);
+        }
+    }
+
+    private static final Pack[] PACKS = {
+            new Pack(PACK_VN_2D, R.string.a06_pack_vn_2d, R.string.a06_pack_vn_2d_description),
+            new Pack(PACK_LIGHT_3D, R.string.a06_pack_light_3d, R.string.a06_pack_light_3d_description)
+    };
+
+    public static ArrayList<Pack> getPacks() {
+        ArrayList<Pack> result = new ArrayList<>();
+        for (Pack pack : PACKS) result.add(pack);
+        return result;
+    }
+
+    public static boolean isInstalled(Container container, String packId) {
+        return VERSION.equals(container.getExtra(getMarkerName(packId)));
+    }
+
+    public static boolean install(Context context, Container container, String packId) {
+        if (container == null || !isKnownPack(packId)) return false;
+        if (isInstalled(container, packId)) return true;
+        if (!A06Preinstall.prepareContainer(context, container)) return false;
+
+        String oldWinComponents = container.getWinComponents();
+        String oldEnvVars = container.getEnvVars();
+        String oldDXWrapper = container.getDXWrapper();
+        String oldBox64Preset = container.getBox64Preset();
+
+        applySettings(container, packId);
+        boolean success = A06Preinstall.prepareSelectedWinComponents(context, container);
+        if (!success) {
+            container.setWinComponents(oldWinComponents);
+            container.setEnvVars(oldEnvVars);
+            container.setDXWrapper(oldDXWrapper);
+            container.setBox64Preset(oldBox64Preset);
+            return false;
+        }
+
+        container.putExtra(getMarkerName(packId), VERSION);
+        container.saveData();
+        return true;
+    }
+
+    private static void applySettings(Container container, String packId) {
+        KeyValueSet winComponents = new KeyValueSet(container.getWinComponents());
+        EnvVars envVars = new EnvVars(container.getEnvVars());
+
+        winComponents.put("direct3d", 1)
+                .put("directsound", 1)
+                .put("directmusic", 1)
+                .put("xaudio", 1)
+                .put("vcrun2010", 1)
+                .put("wmdecoder", 1);
+
+        if (PACK_VN_2D.equals(packId)) {
+            winComponents.put("directshow", 1).put("vcrun2005", 1);
+            container.setBox64Preset(Box64Preset.CONSERVATIVE);
+        }
+        else if (PACK_LIGHT_3D.equals(packId)) {
+            container.setDXWrapper(DXWrappers.DXVK);
+            container.setBox64Preset(Box64Preset.PERFORMANCE);
+            envVars.put("MESA_SHADER_CACHE_DISABLE", "false")
+                    .put("MESA_SHADER_CACHE_MAX_SIZE", "256MB")
+                    .put("mesa_glthread", "true")
+                    .put("WINEESYNC", "1");
+        }
+
+        container.setWinComponents(winComponents.toString());
+        container.setEnvVars(envVars.toString());
+    }
+
+    private static boolean isKnownPack(String packId) {
+        return PACK_VN_2D.equals(packId) || PACK_LIGHT_3D.equals(packId);
+    }
+
+    private static String getMarkerName(String packId) {
+        return "a06_pack_"+packId;
+    }
+}
diff --git a/app/src/main/java/com/winlator/core/A06Preinstall.java b/app/src/main/java/com/winlator/core/A06Preinstall.java
new file mode 100644
index 0000000..45d6714
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/A06Preinstall.java
@@ -0,0 +1,95 @@
+package com.winlator.core;
+
+import android.content.Context;
+
+import com.winlator.container.Container;
+import com.winlator.xenvironment.RootFS;
+
+import java.io.File;
+import java.util.concurrent.Executors;
+
+/**
+ * Installs the small, offline A06 compatibility pack used by the default
+ * container profile. The normal Winlator setup remains responsible for
+ * registry overrides and user-selected component versions.
+ */
+public abstract class A06Preinstall {
+    public static final String VERSION = "1";
+    private static final String ROOTFS_MARKER = ".winlator/a06-preinstall";
+    private static final String CONTAINER_MARKER = ".a06-preinstall";
+
+    private static final String[] ROOTFS_ASSETS = {
+            "graphics_driver/vortek-"+DefaultVersion.VORTEK+".tzst",
+            "graphics_driver/gladio-"+DefaultVersion.GLADIO+".tzst"
+    };
+
+    private static final String[] CONTAINER_ASSETS = {
+            "dxwrapper/dxvk-"+DefaultVersion.MINOR_DXVK+".tzst",
+            "dxwrapper/d8vk-"+DefaultVersion.D8VK+".tzst",
+            "dxwrapper/vkd3d-"+DefaultVersion.VKD3D+".tzst"
+    };
+
+    public static void prepareRootFSAsync(Context context) {
+        Executors.newSingleThreadExecutor().execute(() -> prepareRootFS(context));
+    }
+
+    public static synchronized boolean prepareRootFS(Context context) {
+        RootFS rootFS = RootFS.find(context);
+        File marker = new File(rootFS.getRootDir(), ROOTFS_MARKER);
+        if (isPrepared(marker)) return true;
+
+        boolean success = true;
+        for (String asset : ROOTFS_ASSETS) {
+            success &= TarCompressorUtils.extract(TarCompressorUtils.Type.ZSTD, context, asset, rootFS.getRootDir());
+        }
+        GeneralComponents.extractFile(GeneralComponents.Type.BOX64, context, DefaultVersion.BOX64, DefaultVersion.BOX64);
+
+        if (success) writeMarker(marker);
+        return success;
+    }
+
+    public static synchronized boolean prepareContainer(Context context, Container container) {
+        File marker = new File(container.getRootDir(), CONTAINER_MARKER);
+        boolean success = true;
+        if (!isPrepared(marker)) {
+            File windowsDir = new File(container.getRootDir(), ".wine/drive_c/windows");
+            windowsDir.mkdirs();
+
+            for (String asset : CONTAINER_ASSETS) {
+                success &= TarCompressorUtils.extract(TarCompressorUtils.Type.ZSTD, context, asset, windowsDir);
+            }
+
+            success &= prepareSelectedWinComponents(context, container);
+            if (success) writeMarker(marker);
+        }
+        return success;
+    }
+
+    /** Extracts the currently selected WinComponents after a profile changes them. */
+    public static synchronized boolean prepareSelectedWinComponents(Context context, Container container) {
+        File windowsDir = new File(container.getRootDir(), ".wine/drive_c/windows");
+        windowsDir.mkdirs();
+        boolean success = true;
+        for (String[] component : new KeyValueSet(container.getWinComponents())) {
+            if (component.length == 2 && component[1].equals("1")) {
+                success &= TarCompressorUtils.extract(
+                        TarCompressorUtils.Type.ZSTD,
+                        context,
+                        "wincomponents/"+component[0]+".tzst",
+                        windowsDir
+                );
+            }
+        }
+        return success;
+    }
+
+    private static boolean isPrepared(File marker) {
+        return marker.isFile() && VERSION.equals(FileUtils.readString(marker));
+    }
+
+    private static void writeMarker(File marker) {
+        File parent = marker.getParentFile();
+        if (parent != null) parent.mkdirs();
+        FileUtils.writeString(marker, VERSION);
+    }
+}
